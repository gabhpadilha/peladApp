# Copie para .env.local e preencha com os dados do projeto "peladApp" no Supabase
# (Project Settings > API). Ambas são chaves públicas.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app, usada no link mágico enviado por e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
