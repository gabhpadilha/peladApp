# Copie para .env.local e preencha com os dados do projeto "peladApp" no Supabase
# (Project Settings > API). Ambas são chaves públicas.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (links de cadastro e de login mandados no WhatsApp).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETA: só no servidor (sem NEXT_PUBLIC_). Usada para o organizador cadastrar
# jogadores. Project Settings > API Keys > Secret keys. Nunca commite.
SUPABASE_SECRET_KEY=sb_secret_...
